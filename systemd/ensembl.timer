[Unit]
Description=Weekly Ensembl release check

[Timer]
OnCalendar=Sun *-*-* 03:00:00
RandomizedDelaySec=1800
# Ensembl releases quarterly-ish; a weekly check that finds nothing new is cheap.
# Persistent: a missed trigger (host down) runs at next boot.
Persistent=true

[Install]
WantedBy=timers.target
